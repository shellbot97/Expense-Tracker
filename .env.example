# Database
DATABASE_URL=sqlite:///./expense_tracker.db

# Security
JWT_SECRET=your-secret-key-change-this-to-random-string-min-32-chars
JWT_EXPIRY_HOURS=24

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI Features (Optional - for F010, F011)
AI_PROVIDER=ollama
AI_MODEL=llama3
AI_API_BASE=http://localhost:11434  # Ollama default endpoint

# Server
API_HOST=0.0.0.0
API_PORT=8000

# CORS (adjust for production)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
